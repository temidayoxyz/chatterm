{
  "name": "chatterm",
  "version": "0.1.1",
  "description": "A local-first terminal emulator that turns command history into a conversation.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run check && npm run test && npm run build",
    "tauri": "tauri"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/temidayoxyz/chatterm.git"
  },
  "homepage": "https://github.com/temidayoxyz/chatterm",
  "bugs": "https://github.com/temidayoxyz/chatterm/issues",
  "author": "Temidayo",
  "license": "MIT",
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@lucide/svelte": "^1.33.0",
    "@tauri-apps/api": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "@tauri-apps/cli": "^2",
    "vitest": "^4.1.10"
  }
}
